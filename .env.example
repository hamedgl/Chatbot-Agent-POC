# ── LLM Provider ──────────────────────────────────────────────────────────────
# "lmstudio"  →  local LM Studio server (default for dev)
# "bedrock"   →  Amazon Bedrock (used in AWS deployment)
LLM_PROVIDER=lmstudio

# LM Studio (LLM_PROVIDER=lmstudio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LLM_MODEL_NAME=google/gemma-4-e4b

# Amazon Bedrock (LLM_PROVIDER=bedrock)
# Use a cross-region inference profile for newer models (us.* prefix)
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
AWS_REGION=us-east-1

# Shared
LLM_TEMPERATURE=0.2

# ── Session ────────────────────────────────────────────────────────────────────
# Hours before an idle in-memory session is evicted (does not delete DB history)
SESSION_TTL_HOURS=24

# ── Database ───────────────────────────────────────────────────────────────────
# Local SQLite:
DATABASE_URL=sqlite:///app.db
# AWS RDS PostgreSQL (injected via Secrets Manager in ECS):
# DATABASE_URL=postgresql://chatbot:password@host:5432/chatbot

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins — never use * in production
# Local:
ALLOWED_ORIGINS=http://localhost:5173
# AWS (set to your CloudFront URL):
# ALLOWED_ORIGINS=https://dmsubqnpr7kho.cloudfront.net

# ── Frontend ───────────────────────────────────────────────────────────────────
# Local dev (Vite): point at the backend
# VITE_API_URL=http://localhost:8000
# AWS (baked into .env.production — do not set here for AWS builds):
# VITE_API_URL=https://dmsubqnpr7kho.cloudfront.net
